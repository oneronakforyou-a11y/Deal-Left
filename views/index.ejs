<!DOCTYPE html>
<html>
<head>
  <title>Home | DealLeft</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/header') %>
  <%- include('partials/nav') %>

  <!-- HERO SECTION -->
  <section class="hero">
    <h1>Welcome to DealLeft</h1>
    <p>Find amazing deals on leftover and clearance stock</p>
    <a href="/products"><button class="btn">Browse Deals</button></a>
  </section>

  <!-- FEATURED DEALS -->
  <section class="featured">
    <h2><B>🔥 Featured Offers !<B></h2>

    <div class="deal-grid">
      <div class="deal-card">
        <img src="/images/shoes.jpg">
        <h3>Sneakers Clearance</h3>
        <p>Flat 40% Off</p>
      </div>

      <div class="deal-card">
        <img src="/images/headphones.jpg">
        <h3>Electronics Stock</h3>
        <p>Up to 60% Off</p>
      </div>

      <div class="deal-card">
        <img src="/images/clothes.jpg">
        <h3>Apparel Deals</h3>
        <p>Starting at ₹249</p>
      </div>
    </div>
  </section>
  <!-- ABOUT SECTION (Minimal) -->
<section class="about-home">
  <h2>What is DealLeft?</h2>
  <p>DealLeft helps you find leftover and clearance stock at the best prices. 
     Our platform connects sellers and buyers to reduce waste and provide value.</p>
</section>

</section>



  <%- include('partials/footer') %>

</body>
</html>
